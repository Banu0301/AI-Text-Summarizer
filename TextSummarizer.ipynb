from transformers import pipeline, AutoTokenizer, AutoModelForSeq2SeqLM
import gradio as gr

# Load model and tokenizer
model_name = "facebook/bart-large-cnn"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForSeq2SeqLM.from_pretrained(model_name)
summarizer = pipeline("summarization", model=model, tokenizer=tokenizer)

# Preprocess
def preprocess(text):
    return text.strip().replace("\n", " ")

# Postprocess
def postprocess(summary):
    return summary[0]['summary_text'].strip()

# Summarizer
def summarize_text(text):
    preprocessed_text = preprocess(text)
    summary = summarizer(preprocessed_text, max_length=130, min_length=30, do_sample=False)
    return postprocess(summary)

# Gradio UI
interface = gr.Interface(
    fn=summarize_text,
    inputs=gr.Textbox(lines=10, placeholder="Paste your long text here..."),
    outputs="text",
    title="AI Text Summarizer",
    description="Summarizes long text using BART model from Hugging Face Transformers."
)

interface.launch()
